{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eco",
  "version": "0.1.3",
  "identifier": "online.litteris.eco.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eco",
        "width": 800,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://eco.litteris.online ipc: http://ipc.localhost https://api.github.com https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "headerImage": "./nsis/header.bmp",
        "uninstallerHeaderImage": "./nsis/header.bmp",
        "sidebarImage": "./nsis/sidebar.bmp",
        "startMenuFolder": "Eco",
        "languages": ["PortugueseBrazilian", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ecoapp.litteris.online/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNEZGQ0NFRThBNTA2RDMKUldUVEJxWG96dnhQWVFkKzU2MDBaakZuTW9ONTR0ZEwwNWVwUHh5VzZ5Zk01YTJoNGtBT0hxaEcK"
    }
  }
}
