# Echo Desktop — Variáveis de Ambiente
# Copie para .env e preencha os valores

# API Própria (substitui Appwrite)
VITE_ECHO_API_URL=https://api.echo.litteris.online

# Profile API (mesma que acima)
VITE_PROFILE_API_URL=https://api.echo.litteris.online

# Appwrite (deprecated — mantido para compatibilidade)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6ad904ff0035aa68066c
VITE_APPWRITE_API_KEY=
VITE_APPWRITE_BUCKET_ID=profile-images
VITE_APPWRITE_DATABASE_ID=echo-db
VITE_APPWRITE_PROFILES_COLLECTION_ID=user_profiles
VITE_APPWRITE_GUILDS_COLLECTION_ID=guild_profiles
