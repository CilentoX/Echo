/// Prisma schema for Echo API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserToken {
  userId      String @unique
  accessToken String  // encrypted
  refreshToken String? // encrypted
  deviceId    String?
  updatedAt   DateTime @updatedAt
}