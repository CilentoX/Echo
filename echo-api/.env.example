# Echo API - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais

# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================
# O PostgreSQL sobe junto via docker-compose,
# então o host é 'db' (nome do serviço no compose)
DATABASE_URL=postgresql://echo_api:echo_api_password@echo-api-db:5432/echo_profiles

# ============================================
# SEGURANÇA
# ============================================
# Chave para autenticar requisições server-side na Echo API
# Gere uma chave aleatória: openssl rand -base64 32
API_KEY=sua_chave_api_aqui

# Chave para assinar JWT tokens (SSO login)
# Gere uma chave aleatória: openssl rand -base64 32
JWT_SECRET=sua_chave_jwt_aqui

# ============================================
# URL PÚBLICA DA API
# ============================================
PUBLIC_BASE_URL=https://api.echo.litteris.online

# ============================================
# CONFIGURAÇÃO DO SERVIDOR
# ============================================
PORT=3001
NODE_ENV=production
UPLOAD_DIR=/app/src/uploads
MAX_FILE_SIZE=10485760

# ============================================
# POSTGRES (para o container db)
# ============================================
POSTGRES_USER=echo_api
POSTGRES_PASSWORD=echo_api_password
POSTGRES_DB=echo_profiles