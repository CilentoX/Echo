# Eco homeserver — secrets template.
# Usage on the VPS:  cp .env.example .env  then fill the real values below.
# NEVER commit .env. Generate each secret with:  openssl rand -hex 32

# Postgres password (container bootstrap). Same value as SYNAPSE_POSTGRES_PASSWORD.
POSTGRES_PASSWORD=

# Synapse's database password (must match POSTGRES_PASSWORD).
SYNAPSE_POSTGRES_PASSWORD=

# Shared secret used by register_new_matrix_user to create the break-glass admin.
SYNAPSE_REGISTRATION_SHARED_SECRET=

# Google OAuth client (only needed when the OIDC block is enabled later).
SYNAPSE_GOOGLE_CLIENT_ID=
SYNAPSE_GOOGLE_CLIENT_SECRET=
