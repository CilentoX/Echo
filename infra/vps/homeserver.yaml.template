# Eco homeserver — Synapse production config (TEMPLATE).
# This file contains ${VARS} placeholders. Render with envsubst (see README.md):
#   set -a; source .env; set +a
#   mkdir -p synapse && envsubst < homeserver.yaml.template > synapse/homeserver.yaml
# Do not edit the rendered file; edit this template and re-render.
# Config docs: https://element-hq.github.io/synapse/latest/usage/configuration/config_documentation.html

# Public-facing domain; MXIDs are @user:litteris.online. CANNOT be changed later.
server_name: "litteris.online"

# URL clients use to reach this homeserver through Cloudflare + Traefik.
public_baseurl: "https://eco.litteris.online/"

# Signing key: auto-generated on first start if the file does not exist
# (Synapse >= 1.67). Stored inside the synapse_data volume; back it up.
signing_key_path: "/data/litteris.online.signing.key"

# Single HTTP listener, client API only. Federation resource is NOT mounted
# and there are no federation listeners: federation is fully off.
# x_forwarded: true — real client IPs come from Traefik (X-Forwarded-For).
listeners:
  - port: 8008
    type: http
    tls: false
    # Traefik connects over IPv4 only: '*' breaks Twisted 26.4 (gaierror) and
    # dual-stack ['0.0.0.0', '::'] causes EADDRINUSE on the same port.
    bind_addresses: ['0.0.0.0']
    x_forwarded: true
    resources:
      - names:
          - client

# PostgreSQL (container "eco-postgres" on eco_net). Password from .env via envsubst.
database:
  name: psycopg2
  args:
    user: synapse
    password: "${SYNAPSE_POSTGRES_PASSWORD}"
    dbname: synapse
    # Host must be the unique container_name `eco-postgres`: the bare name
    # `postgres` collides with coolify-db's alias on the shared coolify network.
    host: eco-postgres
    port: 5432
    cp_min: 5
    cp_max: 10

# Media repository.
media_store_path: "/data/media_store"
max_upload_size: "50M"

# Accounts: registration is closed. Admin is created via CLI (break-glass,
# see README); invite-token registration comes in a later phase.
enable_registration: false
registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"
allow_guest_access: false

# Closed network: no federation at all, no trusted key servers, and profile
# data over the client API requires authentication.
federation_domain_whitelist: []
allow_profile_lookup_over_federation: false
allow_device_name_lookup_over_federation: false
require_auth_for_profile_requests: true
trusted_key_servers: []
suppress_key_server_warning: true

# No phone-home to matrix.org, no metrics endpoint.
report_stats: false
enable_metrics: false

