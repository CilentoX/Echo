# Echo homeserver — Synapse config rendered INSIDE the container at every boot
# by render-config.sh (envsubst over this template). Environment variables are
# injected by Coolify as application env vars — secrets never live in git.
# Config docs: https://element-hq.github.io/synapse/latest/usage/configuration/config_documentation.html

# Public-facing domain; MXIDs are @user:litteris.online. CANNOT be changed later.
server_name: "litteris.online"

# URL clients use to reach this homeserver through Cloudflare + Traefik.
public_baseurl: "https://echo.litteris.online/"

# Signing key: auto-generated on first start if the file does not exist.
# Stored inside the eco_synapse_data volume; back it up.
signing_key_path: "/data/litteris.online.signing.key"

# Single HTTP listener, client API only. Federation resource is NOT mounted
# and there are no federation listeners: federation is fully off.
# x_forwarded: true — real client IPs come from Traefik (X-Forwarded-For).
listeners:
  - port: 8008
    type: http
    tls: false
    # Traefik connects over IPv4 only: '*' breaks Twisted 26.4 (gaierror) and
    # dual-stack ['0.0.0.0', '::'] causes EADDRINUSE on the same port.
    bind_addresses: ['0.0.0.0']
    x_forwarded: true
    resources:
      - names:
          - client

# PostgreSQL. Host is the stable network alias `echo-postgres` defined in
# docker-compose.yml — Coolify's compose build pack renames containers per
# deploy, so container_name is not a reliable DNS name under Coolify.
database:
  name: psycopg2
  args:
    user: synapse
    password: "${SYNAPSE_POSTGRES_PASSWORD}"
    dbname: synapse
    host: echo-postgres
    port: 5432
    cp_min: 5
    cp_max: 10

# Media repository.
media_store_path: "/data/media_store"
max_upload_size: "50M"

# Accounts: registration is closed. Admin was created via CLI (break-glass).
enable_registration: false
registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"
allow_guest_access: false

# Closed network: no federation at all, no trusted key servers, and profile
# data over the client API requires authentication.
federation_domain_whitelist: []
allow_profile_lookup_over_federation: false
allow_device_name_lookup_over_federation: false
require_auth_for_profile_requests: true
trusted_key_servers: []
suppress_key_server_warning: true

# No phone-home to matrix.org, no metrics endpoint.
report_stats: false
enable_metrics: false

# Custom templates for login/registration pages (Echo branding).
# Deployed into the eco_synapse_data volume at /data/templates
# (see infra/vps/synapse-templates/ + runbook in infra/vps/README.md).
templates:
  custom_template_directory: "/data/templates"

# --- Google OIDC (ACTIVE) ----------------------------------------------------
# Authorized redirect URI in Google Cloud Console:
#   https://echo.litteris.online/_synapse/client/oidc/callback
# Synapse exposes the provider id as "oidc-google" (idp_id gets the prefix).
# localpart_template derives a valid MXID localpart from the Google email so
# SSO registration never fails with MappingException. confirm_localpart lets
# the user adjust it on first login. Templates use Jinja2 {{ ... }} braces,
# which envsubst leaves untouched.
oidc_providers:
  - idp_id: google
    idp_name: "Google"
    issuer: "https://accounts.google.com/"
    client_id: "${SYNAPSE_GOOGLE_CLIENT_ID}"
    client_secret: "${SYNAPSE_GOOGLE_CLIENT_SECRET}"
    scopes:
      - "openid"
      - "profile"
      - "email"
    enable_registration: true
    # Redirect URI para o callback SSO do Echo Desktop (Tauri loopback na porta 1421).
    # Sem isso o Synapse rejeita o redirect_uri http://localhost:1421/callback e
    # o callback SSO nunca chega ao listener do app.
    redirect_uris:
      - "http://localhost:1421/callback"
    user_mapping_provider:
      config:
        confirm_localpart: true
        localpart_template: "{{ user.email.split('@')[0]|lower }}"
        display_name_template: "{{ user.name }}"
        email_template: "{{ user.email }}"
